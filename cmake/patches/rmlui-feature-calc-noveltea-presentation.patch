--- a/Source/Core/Context.cpp
+++ b/Source/Core/Context.cpp
@@ -155,6 +155,54 @@ Vector2i Context::GetDimensions() const
 	return dimensions;
 }
 
+void Context::SetMediaQueryDimensions(const Vector2i _dimensions)
+{
+	const Vector2i previous_dimensions = GetMediaQueryDimensions();
+	media_query_dimensions = _dimensions;
+	has_media_query_dimensions = true;
+
+	if (previous_dimensions != GetMediaQueryDimensions())
+		DirtyMediaQueries();
+}
+
+void Context::ClearMediaQueryDimensions()
+{
+	if (!has_media_query_dimensions)
+		return;
+
+	const Vector2i previous_dimensions = GetMediaQueryDimensions();
+	has_media_query_dimensions = false;
+
+	if (previous_dimensions != GetMediaQueryDimensions())
+		DirtyMediaQueries();
+}
+
+Vector2i Context::GetMediaQueryDimensions() const
+{
+	return has_media_query_dimensions ? media_query_dimensions : dimensions;
+}
+
+void Context::SetTextScaleFactor(float scale)
+{
+	if (text_scale_factor != scale)
+	{
+		text_scale_factor = scale;
+		root->DirtyFontFaceRecursive();
+
+		for (int i = 0; i < root->GetNumChildren(); ++i)
+		{
+			ElementDocument* document = root->GetChild(i)->GetOwnerDocument();
+			if (document != nullptr)
+				document->DirtyLayout();
+		}
+	}
+}
+
+float Context::GetTextScaleFactor() const
+{
+	return text_scale_factor;
+}
+
 void Context::SetDensityIndependentPixelRatio(float dp_ratio)
 {
 	if (density_independent_pixel_ratio != dp_ratio)
@@ -1554,6 +1602,18 @@ void Context::GenerateDragEventParameters(Dictionary& parameters)
 	parameters["drag_element"] = (void*)drag;
 }
 
+void Context::DirtyMediaQueries()
+{
+	for (int i = 0; i < root->GetNumChildren(); ++i)
+	{
+		ElementDocument* document = root->GetChild(i)->GetOwnerDocument();
+		if (document != nullptr)
+		{
+			document->DirtyMediaQueries();
+		}
+	}
+}
