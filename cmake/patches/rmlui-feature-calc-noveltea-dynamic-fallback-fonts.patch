 	Style::FontWeight weight = Style::FontWeight::Auto, bool fallback_face = false, int face_index = 0);
 
+/// Replaces the ordered global fallback font-face list with all loaded faces belonging to the given font families.
+/// @param[in] families Font family names in fallback priority order. Families must already be loaded.
+/// @return True if every family was found and the fallback list was replaced, false otherwise.
+RMLUICORE_API bool SetFallbackFontFamilies(const StringList& families);
+
 /// Registers a generic RmlUi plugin.
