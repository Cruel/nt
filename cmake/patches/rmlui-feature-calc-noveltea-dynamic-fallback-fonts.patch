 		bool fallback_face) override;
 
+	bool SetFallbackFontFamilies(const StringList& families) override;
+
 	/// Returns a handle to a font face that can be used to position and render text. This will return the closest match
 	/// it can find, but in the event a font family is requested that does not exist, NULL will be returned instead of a
 	/// valid handle.
diff --git a/Source/Core/FontEngineDefault/FontFamily.cpp b/Source/Core/FontEngineDefault/FontFamily.cpp
--- a/Source/Core/FontEngineDefault/FontFamily.cpp
+++ b/Source/Core/FontEngineDefault/FontFamily.cpp
@@ -68,6 +68,12 @@ auto FontFamily::AddFace(FontFaceHandleFreetype ft_face, Style::FontStyle style,
 	return result;
 }
 
+void FontFamily::AppendFaces(Vector<FontFace*>& faces) const
+{
+	for (const auto& entry : font_faces)
+		faces.push_back(entry.face.get());
+}
+
 void FontFamily::ReleaseFontResources()
 {
 	for (auto& entry : font_faces)
diff --git a/Source/Core/FontEngineDefault/FontFamily.h b/Source/Core/FontEngineDefault/FontFamily.h
--- a/Source/Core/FontEngineDefault/FontFamily.h
+++ b/Source/Core/FontEngineDefault/FontFamily.h
@@ -33,6 +33,9 @@ public:
 	/// @return A result flag and a pointer to the new font face on success.
 	AddFaceResult AddFace(FontFaceHandleFreetype ft_face, Style::FontStyle style, Style::FontWeight weight, UniquePtr<byte[]> face_memory);
 
+	/// Appends all loaded faces in this family to an ordered fallback list.
+	void AppendFaces(Vector<FontFace*>& faces) const;
+
 	/// Releases resources owned by sized font faces, including their textures and rendered glyphs.
 	void ReleaseFontResources();
 
diff --git a/Source/Core/FontEngineDefault/FontProvider.cpp b/Source/Core/FontEngineDefault/FontProvider.cpp
--- a/Source/Core/FontEngineDefault/FontProvider.cpp
+++ b/Source/Core/FontEngineDefault/FontProvider.cpp
@@ -61,6 +61,21 @@ FontFaceHandleDefault* FontProvider::GetFontFaceHandle(
 	return it->second->GetFaceHandle(style, weight, size, raster_size);
 }
 
+bool FontProvider::SetFallbackFontFamilies(const StringList& families)
+{
+	auto& provider = Get();
+	FontFaceList fallback_faces;
+	for (const String& family : families)
+	{
+		auto it = provider.font_families.find(StringUtilities::ToLower(family));
+		if (it == provider.font_families.end())
+			return false;
+		it->second->AppendFaces(fallback_faces);
+	}
+	provider.fallback_font_faces = std::move(fallback_faces);
+	return true;
+}
+
 int FontProvider::CountFallbackFontFaces()
 {
 	return (int)Get().fallback_font_faces.size();
diff --git a/Source/Core/FontEngineDefault/FontProvider.h b/Source/Core/FontEngineDefault/FontProvider.h
--- a/Source/Core/FontEngineDefault/FontProvider.h
+++ b/Source/Core/FontEngineDefault/FontProvider.h
@@ -47,6 +47,9 @@ public:
 	static bool LoadFontFace(Span<const byte> data, int face_index, const String& font_family, Style::FontStyle style, Style::FontWeight weight,
 		bool fallback_face);
 
+	/// Replaces the ordered fallback list using all loaded faces in the given families.
+	static bool SetFallbackFontFamilies(const StringList& families);
+
 	/// Return the number of fallback font faces.
 	static int CountFallbackFontFaces();
 
