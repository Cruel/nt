body {
    margin: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#nt_verb_menu {
    position: absolute;
    min-width: 180px;
    max-width: 360px;
    padding: 10px;
    border-width: 1px;
    border-color: #807766;
    background-color: #201e1bcc;
    pointer-events: auto;
}

.nt-verb-menu-heading {
    margin: 0 0 8px 0;
    font-weight: bold;
}

.nt-verb-menu-action,
.nt-verb-menu-close {
    display: block;
    width: 100%;
    margin-top: 4px;
}
