<rml>
<head>
    <title>NovelTea Game HUD</title>
    <link type="text/rcss" href="system|/ui/runtime/runtime_game.rcss"/>
</head>
<body>
    <div id="rt_root">
        <div id="rt_hud_header">
            <div id="rt_header_copy">
                <h1 id="rt_title"></h1>
                <p id="rt_notification"></p>
            </div>
            <button id="rt_menu" onclick="Game.shell.pause()">Menu</button>
        </div>

        <div id="rt_interaction_dock">
            <div id="rt_objects_group" class="rt-control-group">
                <p class="rt-control-heading">Nearby</p>
                <div id="rt_objects"></div>
            </div>
            <div id="rt_inventory_group" class="rt-control-group">
                <p class="rt-control-heading">Inventory</p>
                <div id="rt_inventory"></div>
            </div>
            <div id="rt_actions_group" class="rt-control-group">
                <p class="rt-control-heading">Actions</p>
                <div id="rt_actions"></div>
            </div>
        </div>

        <div id="rt_text_panel">
            <nt-active-text id="rt_body"></nt-active-text>
            <div id="rt_options"></div>
        </div>

        <div id="rt_navigation">
            <button id="rt_nav_northwest" class="nav nav-slot nav-northwest nav-slot-northwest" data-direction="northwest"><span class="nav-glyph">NW</span><span class="nav-label"></span></button>
            <button id="rt_nav_north" class="nav nav-slot nav-north nav-slot-north" data-direction="north"><span class="nav-glyph">N</span><span class="nav-label"></span></button>
            <button id="rt_nav_northeast" class="nav nav-slot nav-northeast nav-slot-northeast" data-direction="northeast"><span class="nav-glyph">NE</span><span class="nav-label"></span></button>
            <button id="rt_nav_west" class="nav nav-slot nav-west nav-slot-west" data-direction="west"><span class="nav-glyph">W</span><span class="nav-label"></span></button>
            <button id="rt_nav_custom" class="nav nav-slot nav-custom nav-slot-custom" data-direction="custom"><span class="nav-glyph">GO</span><span class="nav-label"></span></button>
            <button id="rt_nav_east" class="nav nav-slot nav-east nav-slot-east" data-direction="east"><span class="nav-glyph">E</span><span class="nav-label"></span></button>
            <button id="rt_nav_southwest" class="nav nav-slot nav-southwest nav-slot-southwest" data-direction="southwest"><span class="nav-glyph">SW</span><span class="nav-label"></span></button>
            <button id="rt_nav_south" class="nav nav-slot nav-south nav-slot-south" data-direction="south"><span class="nav-glyph">S</span><span class="nav-label"></span></button>
            <button id="rt_nav_southeast" class="nav nav-slot nav-southeast nav-slot-southeast" data-direction="southeast"><span class="nav-glyph">SE</span><span class="nav-label"></span></button>
        </div>
    </div>
</body>
</rml>
