<rml>
<head>
    <title>NovelTea Game HUD</title>
    <link type="text/rcss" href="system|/ui/runtime/runtime_game.rcss"/>
</head>
<body data-model="noveltea">
    <div id="rt_root">
        <div id="rt_hud_header">
            <div id="rt_header_copy">
                <h1 id="rt_title" data-if="gameplay.title != ''">{{ gameplay.title }}</h1>
                <p id="rt_notification" data-if="gameplay.notification != ''">{{ gameplay.notification }}</p>
            </div>
            <button id="rt_menu" data-event-click="shell_pause()">Menu</button>
        </div>

        <div id="rt_interaction_dock"
             data-if="gameplay.room.objects.size > 0 || gameplay.inventory.items.size > 0">
            <div id="rt_objects_group" class="rt-control-group" data-if="gameplay.room.objects.size > 0">
                <p class="rt-control-heading">Nearby</p>
                <div id="rt_objects">
                    <button data-for="object : gameplay.room.objects"
                            class="object"
                            data-class-disabled="!object.enabled"
                            data-class-selected="object.selected"
                            data-attrif-disabled="!object.enabled"
                            data-event-click="ui_primary_activate(object.subject_kind, object.subject_id)">
                        {{ object.label }}
                    </button>
                    <button data-for="object : gameplay.room.objects"
                            class="object-menu"
                            data-attrif-disabled="!object.enabled"
                            data-event-click="ui_open_verb_menu(object.subject_kind, object.subject_id)">
                        Actions…
                    </button>
                </div>
            </div>
            <div id="rt_inventory_group" class="rt-control-group" data-if="gameplay.inventory.items.size > 0">
                <p class="rt-control-heading">Inventory</p>
                <div id="rt_inventory">
                    <button data-for="item : gameplay.inventory.items"
                            class="object"
                            data-class-disabled="!item.enabled"
                            data-class-selected="item.selected"
                            data-attrif-disabled="!item.enabled"
                            data-event-click="ui_primary_activate('interactable', item.id)">
                        {{ item.display_name }}
                    </button>
                    <button data-for="item : gameplay.inventory.items"
                            class="object-menu"
                            data-attrif-disabled="!item.enabled"
                            data-event-click="ui_open_verb_menu('interactable', item.id)">
                        Actions…
                    </button>
                </div>
            </div>
        </div>

        <div id="rt_text_panel"
             data-if="gameplay.active_text_available || gameplay.dialogue.choices.size > 0"
             data-style-pointer-events="gameplay.can_continue || gameplay.dialogue.choices.size > 0 ? 'auto' : 'none'">
            <nt-active-text id="rt_body"></nt-active-text>
            <div id="rt_options">
                <button data-for="choice : gameplay.dialogue.choices"
                        class="option"
                        data-class-disabled="!choice.enabled"
                        data-attrif-disabled="!choice.enabled"
                        data-event-click="ui_choose('dialogue', choice.id)">
                    {{ choice.label }}
                </button>
            </div>
        </div>

        <div id="rt_navigation" data-if="gameplay.room.has_enabled_exits">
            <button data-for="exit : gameplay.room.exits"
                    data-if="exit.enabled"
                    class="nav nav-slot"
                    data-class-nav-slot-northwest="exit.direction == 'northwest'"
                    data-class-nav-slot-north="exit.direction == 'north'"
                    data-class-nav-slot-northeast="exit.direction == 'northeast'"
                    data-class-nav-slot-west="exit.direction == 'west'"
                    data-class-nav-slot-custom="exit.direction == 'custom'"
                    data-class-nav-slot-east="exit.direction == 'east'"
                    data-class-nav-slot-southwest="exit.direction == 'southwest'"
                    data-class-nav-slot-south="exit.direction == 'south'"
                    data-class-nav-slot-southeast="exit.direction == 'southeast'"
                    data-event-click="ui_navigate_room(exit.id)">
                <span class="nav-glyph">{{ exit.glyph }}</span>
                <span class="nav-label">{{ exit.label }}</span>
            </button>
        </div>
    </div>
</body>
</rml>
