<rml>
<head>
    <title>NovelTea Text Log</title>
    <link type="text/rcss" href="system|/ui/menu/system-menu.rcss"/>
</head>
<body data-model="noveltea">
    <main class="nt-shell-root nt-shell-root-transparent">
        <section class="nt-shell-panel nt-shell-panel-wide">
            <p class="nt-shell-kicker"><nt-tr key="noveltea.text_log.history"/></p>
            <h1><nt-tr key="noveltea.text_log.title"/></h1>
            <div id="rt_log">
                <div class="nt-text-log__empty" data-if="gameplay.text_log.entries.size == 0"><nt-tr key="noveltea.text_log.empty"/></div>
                <div class="nt-text-log__entry" data-for="entry : gameplay.text_log.entries"
                     data-attr-data-sequence="entry.sequence" data-attr-data-kind="entry.kind">
                    <span class="nt-text-log__speaker" data-if="entry.has_speaker">{{ entry.speaker_id }}</span>
                    <div class="nt-text-log__body" data-rml="entry.body_rml"></div>
                </div>
            </div>
            <button data-event-click="shell_close()"><nt-tr key="noveltea.shell.back"/></button>
            <p id="nt-shell-status">{{ shell.status }}</p>
        </section>
    </main>
</body>
</rml>
