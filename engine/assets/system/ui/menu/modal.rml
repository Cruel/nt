<rml>
<head>
    <title>NovelTea Confirmation</title>
    <link type="text/rcss" href="system|/ui/menu/system-menu.rcss"/>
</head>
<body data-model="noveltea">
    <main class="nt-shell-root">
        <section class="nt-shell-panel">
            <p class="nt-shell-kicker"><nt-tr key="noveltea.confirmation.confirm"/></p>
            <h1><nt-tr key="noveltea.confirmation.prompt"/></h1>
            <p id="nt-modal-prompt">{{ shell.confirmation.prompt }}</p>
            <div class="nt-shell-actions">
                <button data-event-click="shell_confirm()"><nt-tr key="noveltea.confirmation.confirm"/></button>
                <button data-event-click="shell_cancel()"><nt-tr key="noveltea.confirmation.cancel"/></button>
            </div>
            <p id="nt-shell-status">{{ shell.status }}</p>
        </section>
    </main>
</body>
</rml>
