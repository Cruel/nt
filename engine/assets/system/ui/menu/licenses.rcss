#nt-licenses-panel {
    width: 940px;
    height: 85%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
}
#nt-license-columns {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
}
#nt-license-list {
    width: 35%;
    padding-right: 12px;
    overflow-y: auto;
}
#nt-license-list h2, #nt-license-content h2 {
    font-size: 17px;
    margin-bottom: 8px;
    color: #7dd3fc;
}
#nt-license-list button {
    text-align: left;
    white-space: normal;
    word-break: break-word;
}
#nt-license-list button.selected, #nt-license-list button:focus {
    background-color: #35536a;
    border-color: #7dd3fc;
}
#nt-license-content {
    width: 65%;
    padding-left: 12px;
    display: flex;
    flex-direction: column;
}
#nt-license-text-scroll {
    flex: 1;
    min-height: 0;
    padding: 12px;
    background-color: #0f1317;
    border: 1px #465866;
    overflow-y: auto;
}
#nt-license-text {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 14px;
}
#nt-license-back { margin-top: 12px; }
#nt-license-scroll-actions { display: flex; gap: 8px; margin-top: 8px; }
#nt-license-scroll-actions button { flex: 1; }
#nt-license-text-scroll:focus { border-color: #7dd3fc; }
#nt-license-diagnostics { font-size: 12px; color: #c9d1d9; }
