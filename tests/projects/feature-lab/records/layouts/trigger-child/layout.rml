<rml><head><title>Child trigger</title></head><body onshow="document:GetElementById('child-values').inner_rml = Game.mount_context():trigger() and 'Child inherited immutable geometry' or 'No trigger snapshot'"><section class="lab-panel" style="left: 850px; top: 850px; width: 500px;"><p id="child-values"></p><button onclick="assert(Game.mount_context():dismiss())">Dismiss only child</button></section></body></rml>
