body { font-family: Liberation Sans; font-size: 20px; color: #e8f3f7; }
.lab-panel { position: absolute; left: 580px; top: 180px; width: 600px; padding: 20px; background-color: #102332ed; border: 2px #8ecddb; }
button { margin: 6px; padding: 8px; background-color: #285574; }
button:focus { border: 2px #fff18b; }
input { width: 220px; }
.scroll-list { height: 110px; overflow: auto; }
