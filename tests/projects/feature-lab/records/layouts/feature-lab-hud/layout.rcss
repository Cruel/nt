body { font-family: 'Liberation Sans'; color: #e8f3f7; }
#feature-lab-toolbar { position: absolute; right: 20px; top: 20px; display: flex; gap: 8px; pointer-events: none; }
#feature-lab-toolbar button { padding: 10px 14px; pointer-events: auto; }
#feature-lab-open { font-size: 18px; }
#feature-lab-notification { position: absolute; left: 6%; bottom: 6%; max-width: 88%; padding: 14px; background-color: #071018; pointer-events: none; }
#feature-lab-scenario-guide { position: absolute; left: 20px; top: 20px; width: 520px; padding: 16px; background-color: rgba(7, 16, 24, 224); border: 1px #52798a; border-radius: 8px; pointer-events: none; }
#feature-lab-scenario-guide h2 { margin: 0 0 12px 0; color: #9dd1df; font-size: 20px; }
#feature-lab-scenario-guide .feature-lab-check { margin: 10px 0; }
.feature-lab-check-instruction { display: flex; gap: 8px; font-size: 17px; line-height: 1.35; }
.feature-lab-check-number { min-width: 22px; color: #9dd1df; font-weight: bold; }
.feature-lab-check-subtext { margin: 3px 0 0 30px; color: #b6cbd4; font-size: 12px; line-height: 1.35; }
#feature-lab-text-panel { position: absolute; left: 14%; right: 14%; bottom: 14%; min-height: 120px; padding: 18px; background-color: rgba(7, 16, 24, 242); border: 2px #52798a; border-radius: 10px; pointer-events: none; }
#rt_body { display: block; min-height: 64px; font-size: 22px; }
#rt_options { margin-top: 10px; }
#rt_options button { display: block; width: 100%; pointer-events: auto; }
.feature-lab-panel { position: absolute; left: 6%; top: 6%; width: 88%; max-height: 86%; overflow: auto; padding: 24px; background-color: rgba(7, 16, 24, 242); border: 2px #52798a; border-radius: 12px; pointer-events: auto; }
.hidden { display: none; }
.feature-lab-header, .feature-lab-controls { display: flex; align-items: center; gap: 10px; }
.feature-lab-header { justify-content: space-between; }
.feature-lab-controls { margin-bottom: 18px; }
.feature-lab-controls input { width: 360px; }
#feature-lab-categories { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
#feature-lab-categories button { font-size: 14px; padding: 6px; }
.feature-lab-category { display: block; width: 100%; margin-top: 18px; }
.feature-lab-category h2 { margin: 0 0 8px 0; color: #9dd1df; font-size: 16px; }
.feature-lab-scenario-grid { display: flex; flex-wrap: wrap; gap: 12px; }
.feature-lab-scenario { display: block; width: 46%; min-width: 320px; padding: 14px; background-color: rgba(31, 52, 63, 220); border-width: 0; border-radius: 8px; color: #e8f3f7; text-align: left; pointer-events: auto; }
.feature-lab-scenario:hover { background-color: rgba(42, 67, 80, 232); }
.feature-lab-scenario-main { display: block; }
.feature-lab-scenario-title { font-size: 18px; font-weight: bold; }
.feature-lab-match { display: block; margin-top: 6px; color: #b6cbd4; font-size: 12px; }
.feature-lab-status { margin-left: 8px; opacity: 0.8; }
.feature-lab-recent { margin-left: 8px; font-weight: bold; color: #8fe4b8; }
