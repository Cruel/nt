          { "id": "room-owner", "type": "property", "operator": "eq", "property": { "scope": "room", "ownerId": "properties-and-traits", "propertyId": "shared-state", "value": "room-updated" } },
          { "id": "character-owner", "type": "property", "operator": "eq", "property": { "scope": "character", "ownerId": "state-witness", "propertyId": "shared-state", "value": 42 } },
          { "id": "instance-owner", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-specimen-instance", "propertyId": "shared-state", "value": "instance-updated" } }
        ]
      },
      {
