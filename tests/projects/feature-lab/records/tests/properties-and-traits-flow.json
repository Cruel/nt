          { "id": "string", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-specimen-instance", "propertyId": "string-prop", "value": "typed" } },
          { "id": "enum", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-specimen-instance", "propertyId": "enum-prop", "value": "beta" } }
