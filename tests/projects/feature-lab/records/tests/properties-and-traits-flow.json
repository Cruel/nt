          { "id": "marker-absent", "type": "trait", "operator": "absent", "trait": { "ownerKind": "interactable", "ownerId": "state-specimen-instance", "traitId": "lab-marker" } },
          { "id": "configured-absent", "type": "trait", "operator": "absent", "trait": { "ownerKind": "interactable", "ownerId": "state-specimen-instance", "traitId": "lab-configured" } },
          { "id": "trait-property-absent", "type": "property", "operator": "absent", "property": { "scope": "interactable", "ownerId": "state-specimen-instance", "propertyId": "trait-value", "value": null } }
        ]
      }
