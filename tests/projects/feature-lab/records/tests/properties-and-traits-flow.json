          { "id": "definition-fallback", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-definition-instance", "propertyId": "layered", "value": "definition-default" } },
          { "id": "archetype-fallback", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-archetype-instance", "propertyId": "layered", "value": "archetype-default" } },
          { "id": "trait-fallback", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-trait-instance", "propertyId": "layered", "value": "trait-default" } }
        ]
      },
      {
