        "runInteraction": { "verb": { "$ref": { "collection": "verbs", "id": "use" } }, "bindings": [{ "slotId": "target", "subject": { "kind": "interactable", "interactable": { "$ref": { "registry": "interactableInstances", "id": "state-trait-control" } } } }] },
        "expectations": [
          { "id": "marker-present", "type": "trait", "operator": "present", "trait": { "ownerKind": "interactable", "ownerId": "state-specimen-instance", "traitId": "lab-marker" } },
          { "id": "configured-present", "type": "trait", "operator": "present", "trait": { "ownerKind": "interactable", "ownerId": "state-specimen-instance", "traitId": "lab-configured" } },
          { "id": "trait-property", "type": "property", "operator": "eq", "property": { "scope": "interactable", "ownerId": "state-specimen-instance", "propertyId": "trait-value", "value": "trait-default-value" } }
        ]
      },
      {
        "id": "conditions", "input": "run-interaction", "label": "Evaluate recursive Conditions with bound slot context",
        "runInteraction": { "verb": { "$ref": { "collection": "verbs", "id": "use" } }, "bindings": [{ "slotId": "target", "subject": { "kind": "interactable", "interactable": { "$ref": { "registry": "interactableInstances", "id": "state-condition-control" } } } }] },
        "expectations": [{ "id": "conditions-hit", "type": "property", "operator": "eq", "property": { "scope": "global", "ownerId": "", "propertyId": "conditions-hit", "value": true } }]
      },
      {
        "id": "remove-traits", "input": "run-interaction", "label": "Remove runtime Traits without copying structural data",
        "runInteraction": { "verb": { "$ref": { "collection": "verbs", "id": "use" } }, "bindings": [{ "slotId": "target", "subject": { "kind": "interactable", "interactable": { "$ref": { "registry": "interactableInstances", "id": "state-trait-control" } } } }] },
