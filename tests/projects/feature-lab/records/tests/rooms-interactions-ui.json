{
  "id": "rooms-interactions-ui",
  "label": "Rooms & Interactions UI flow",
  "data": {
    "kind": "test",
    "displayName": "Rooms & Interactions UI flow",
    "steps": [
      {
        "id": "start",
        "input": "tick",
        "label": "Fresh Lab home",
        "expectations": [
          {
            "id": "home-room",
            "type": "current-room",
            "operator": "eq",
            "currentRoom": { "roomId": "feature-lab-home" }
          }
        ]
      },
      {
        "id": "enter-pilot",
        "input": "ui-click",
        "label": "Launch Rooms pilot through the navigator",
        "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-launch-rooms-interactions" },
        "expectations": [
          {
            "id": "workshop-room",
            "type": "current-room",
            "operator": "eq",
            "currentRoom": { "roomId": "rooms-interactions-workshop" }
          }
        ]
      },
      {
        "id": "dirty-pilot",
        "input": "run-interaction",
        "label": "Unlock before checking restart isolation",
        "runInteraction": {
          "verb": { "$ref": { "collection": "verbs", "id": "use" } },
          "bindings": [{ "slotId": "target", "subject": {
            "kind": "interactable",
            "interactable": { "$ref": { "registry": "interactableInstances", "id": "gate-lever-1" } }
          } }]
        },
        "expectations": [{ "id": "dirty-gate", "type": "property", "operator": "eq",
          "property": { "scope": "global", "ownerId": "", "propertyId": "gate-unlocked", "value": true }
        }]
      },
      {
        "id": "reopen-lab",
        "input": "ui-click",
        "label": "Reopen the Lab without resetting gameplay",
        "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-open" },
        "expectations": [
          {
            "id": "workshop-preserved",
            "type": "current-room",
            "operator": "eq",
            "currentRoom": { "roomId": "rooms-interactions-workshop" }
          },
          {
            "id": "unlocked-preserved",
            "type": "property",
            "operator": "eq",
            "property": { "scope": "global", "ownerId": "", "propertyId": "gate-unlocked", "value": true }
          }
        ]
      },
      {
        "id": "reenter-pilot",
        "input": "ui-click",
        "label": "Launch the scenario again with fresh defaults",
        "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-launch-rooms-interactions" },
        "expectations": [
          {
            "id": "fresh-workshop",
            "type": "current-room",
            "operator": "eq",
            "currentRoom": { "roomId": "rooms-interactions-workshop" }
          },
          {
            "id": "gate-reset",
            "type": "property",
            "operator": "eq",
            "property": { "scope": "global", "ownerId": "", "propertyId": "gate-unlocked", "value": false }
          }
        ]
      },
      {
        "id": "dirty-again", "input": "run-interaction", "label": "Dirty before switching stations",
        "runInteraction": {
          "verb": { "$ref": { "collection": "verbs", "id": "use" } },
          "bindings": [{ "slotId": "target", "subject": {
            "kind": "interactable",
            "interactable": { "$ref": { "registry": "interactableInstances", "id": "gate-lever-1" } }
          } }]
        }
      },
      { "id": "open-before-switch", "input": "ui-click", "label": "Open catalog before switching", "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-open" } },
      { "id": "stress-category", "input": "ui-click", "label": "Show stress station", "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-category-stress-extremes" } },
      {
        "id": "switch-to-stress", "input": "ui-click", "label": "Switch with fresh defaults",
        "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-launch-stress-content" },
        "expectations": [
          { "id": "stress-room", "type": "current-room", "operator": "eq", "currentRoom": { "roomId": "stress-content" } },
          { "id": "stress-warning", "type": "active-flow", "operator": "eq", "activeFlow": { "kind": "scene", "flowId": "stress-content" } },
          { "id": "cross-station-default", "type": "property", "operator": "eq", "property": { "scope": "global", "ownerId": "", "propertyId": "gate-unlocked", "value": false } }
        ]
      },
      { "id": "open-before-return", "input": "ui-click", "label": "Open catalog with suspended Scene", "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-open" } },
      { "id": "world-category", "input": "ui-click", "label": "Show world stations", "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-category-world-interaction" } },
      {
        "id": "return-to-pilot", "input": "ui-click", "label": "Return without the previous Flow",
        "uiClick": { "documentId": "runtime_game", "selector": "#feature-lab-launch-rooms-interactions" },
        "expectations": [
          { "id": "return-room", "type": "current-room", "operator": "eq", "currentRoom": { "roomId": "rooms-interactions-workshop" } },
          { "id": "no-old-flow", "type": "active-flow", "operator": "absent", "activeFlow": { "kind": "scene", "flowId": "stress-content" } },
          { "id": "return-default", "type": "property", "operator": "eq", "property": { "scope": "global", "ownerId": "", "propertyId": "gate-unlocked", "value": false } }
        ]
      }
    ],
    "finalExpectations": [],
    "preview": { "selectedStepId": "start", "selectedObservationIndex": null, "autoOpenReport": true }
  }
}
