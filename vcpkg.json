{
  "name": "noveltea",
  "dependencies": [
    {
      "name": "lua",
      "version>=": "5.5.0"
    },
    {
      "name": "sol2",
      "version>=": "3.5.0"
    },
    "sdl3",
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    "miniaudio",
    {
      "name": "libvpx",
      "platform": "!emscripten"
    },
    "freetype",
    {
      "name": "imgui",
      "features": [
        "sdl3-binding",
        "docking-experimental",
        "freetype"
      ]
    },
    "harfbuzz",
    "sheenbidi",
    "libunibreak",
    "libpng",
    "miniz",
    "nlohmann-json",
    "fast-float"
  ],
  "features": {
    "tests": {
      "description": "NovelTea native test dependencies.",
      "dependencies": [
        "catch2"
      ]
    }
  },
  "overrides": [
    { "name": "libvpx", "version": "1.16.0" },
    {
      "name": "lua",
      "version": "5.5.0",
      "port-version": 1
    },
    {
      "name": "sol2",
      "version": "3.5.0",
      "port-version": 1
    }
  ]
}
