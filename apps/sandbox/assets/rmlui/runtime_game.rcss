body {
    width: 100%;
    height: 100%;
    position: relative;
    margin: 0;
    font-family: Liberation Sans;
    color: #f7f4ed;
    background-color: transparent;
    pointer-events: none;
}

#rt_root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}

#rt_hud_header {
    position: absolute;
    right: 24px;
    top: 24px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    pointer-events: auto;
}

#rt_header_copy { max-width: 520px; margin-right: 10px; }

#rt_title,
#rt_notification {
    display: none;
    margin: 0 0 6px 0;
    padding: 7px 11px;
    color: #f7f4ed;
    background-color: #111820dd;
    border: 1px #8293a0cc;
}

#rt_title { font-size: 20px; }
#rt_notification { font-size: 14px; }

#rt_menu {
    min-width: 76px;
    padding: 9px 13px;
    color: #f7f4ed;
    background-color: #18232ddd;
    border: 1px #8ea4b4dd;
    pointer-events: auto;
}

#rt_interaction_dock {
    display: none;
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 228px;
    max-height: 520px;
    padding: 10px;
    overflow-y: auto;
    background-color: #101820dc;
    border: 1px #728695cc;
    pointer-events: auto;
}

.rt-control-group { margin-bottom: 10px; }
.rt-control-group:last-child { margin-bottom: 0; }

.rt-control-heading {
    margin: 0 0 5px 0;
    color: #b8c8d3;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

#rt_text_panel {
    display: none;
    position: absolute;
    left: 280px;
    right: 276px;
    bottom: 24px;
    min-height: 112px;
    overflow: hidden;
    padding: 17px 20px;
    background-color: #101317e8;
    border: 1px #8d887dcc;
    pointer-events: auto;
}

#rt_body {
    display: block;
    width: 100%;
    min-height: 82px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: #fff4df;
    font-size: 18px;
    line-height: 1.4;
    pointer-events: auto;
}

nt-active-text .nt-active-text__prompt {
    display: block;
    width: 100%;
    margin-top: 8px;
    color: #d8c792;
    font-size: 12px;
}
#rt_options { margin-top: 10px; }

button.option,
button.object,
button.action,
button.clear-selection {
    display: block;
    width: 100%;
    margin-top: 6px;
    padding: 8px 10px;
    color: #f7f4ed;
    background-color: #263640;
    border: 1px #6f8999;
    text-align: left;
    pointer-events: auto;
}

button.option:hover,
button.object:hover,
button.action:hover,
button.clear-selection:hover,
#rt_menu:hover,
button.nav:hover { background-color: #354d5b; }

button.selected { color: #101820; background-color: #a9d8f0; border-color: #e3f5ff; }
button.clear-selection { color: #101820; background-color: #d7c98e; border-color: #f4e7ac; }
button.disabled { color: #82898e; background-color: #24282b; border-color: #4c555b; }

#rt_navigation {
    display: none;
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 228px;
    height: 228px;
    pointer-events: auto;
}

.nav-slot {
    display: block;
    position: absolute;
    width: 68px;
    height: 68px;
    margin: 0;
    padding: 0;
    pointer-events: auto;
}
.nav-slot-northwest { left: 0; top: 0; }
.nav-slot-north { left: 80px; top: 0; }
.nav-slot-northeast { right: 0; top: 0; }
.nav-slot-west { left: 0; top: 80px; }
.nav-slot-custom { left: 80px; top: 80px; }
.nav-slot-east { right: 0; top: 80px; }
.nav-slot-southwest { left: 0; bottom: 0; }
.nav-slot-south { left: 80px; bottom: 0; }
.nav-slot-southeast { right: 0; bottom: 0; }

button.nav {
    display: block;
    width: 68px;
    height: 68px;
    min-width: 68px;
    min-height: 68px;
    margin: 0;
    padding: 6px;
    color: #f7f4ed;
    background-color: #14212be8;
    border: 1px #8ba4b5dd;
    text-align: center;
    pointer-events: auto;
}

.nav-glyph { display: block; width: 100%; font-size: 18px; font-weight: bold; }
.nav-label {
    display: block;
    width: 100%;
    margin-top: 3px;
    font-size: 10px;
    line-height: 1.1;
}
