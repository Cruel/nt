{
  "schemaVersion": 2,
  "id": "flux2-klein-image-edit",
  "label": "Flux 2 Klein Image Edit",
  "provider": "comfyui",
  "classification": "image.edit",
  "description": "Text-guided image editing using the bundled Flux 2 Klein workflow.",
  "workflowFile": "flux2-klein-image-edit.workflow.json",
  "contract": {
    "inputs": {
      "sourceImage": {
        "type": "image",
        "required": true,
        "authoring": {
          "editorField": "imageAsset"
        }
      },
      "prompt": {
        "type": "string",
        "required": true,
        "authoring": {
          "editorField": "textarea"
        }
      },
      "steps": {
        "type": "integer",
        "required": false,
        "defaultValue": 4,
        "authoring": {
          "editorField": "integer"
        }
      },
      "seed": {
        "type": "integer",
        "required": false,
        "authoring": {
          "editorField": "integer"
        }
      },
      "filenamePrefix": {
        "type": "string",
        "required": false,
        "defaultValue": "NovelTea",
        "authoring": {
          "editorField": "text"
        }
      }
    },
    "outputs": {
      "images": {
        "mediaType": "image",
        "required": true,
        "cardinality": "many"
      }
    }
  },
  "bindings": {
    "sourceImage": [
      {
        "nodeId": "76",
        "nodeTitle": "noveltea.sourceImage",
        "classType": "LoadImage",
        "inputName": "image",
        "selector": {
          "title": "noveltea.sourceImage",
          "classType": "LoadImage",
          "inputName": "image"
        }
      }
    ],
    "prompt": [
      {
        "nodeId": "75:74",
        "nodeTitle": "noveltea.prompt",
        "classType": "CLIPTextEncode",
        "inputName": "text",
        "selector": {
          "title": "noveltea.prompt",
          "classType": "CLIPTextEncode",
          "inputName": "text"
        }
      }
    ],
    "seed": [
      {
        "nodeId": "75:73",
        "nodeTitle": "noveltea.seed",
        "classType": "RandomNoise",
        "inputName": "noise_seed",
        "selector": {
          "title": "noveltea.seed",
          "classType": "RandomNoise",
          "inputName": "noise_seed"
        }
      }
    ],
    "steps": [
      {
        "nodeId": "75:62",
        "nodeTitle": "noveltea.steps",
        "classType": "Flux2Scheduler",
        "inputName": "steps",
        "selector": {
          "title": "noveltea.steps",
          "classType": "Flux2Scheduler",
          "inputName": "steps"
        }
      }
    ],
    "filenamePrefix": [
      {
        "nodeId": "9",
        "nodeTitle": "noveltea.output",
        "classType": "SaveImage",
        "inputName": "filename_prefix",
        "selector": {
          "title": "noveltea.output",
          "classType": "SaveImage",
          "inputName": "filename_prefix"
        }
      }
    ]
  },
  "requiredNodeClasses": [
    "SaveImage",
    "LoadImage",
    "KSamplerSelect",
    "UNETLoader",
    "CLIPLoader",
    "VAELoader",
    "EmptyFlux2LatentImage",
    "ImageScaleToTotalPixels",
    "Flux2Scheduler",
    "CLIPTextEncode",
    "ConditioningZeroOut",
    "ReferenceLatent",
    "GetImageSize",
    "VAEEncode",
    "SamplerCustomAdvanced",
    "VAEDecode",
    "RandomNoise",
    "CFGGuider"
  ],
  "outputBindings": {
    "images": [
      {
        "nodeId": "9",
        "nodeTitle": "noveltea.output",
        "classType": "SaveImage"
      }
    ]
  }
}
