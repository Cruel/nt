{
  "schemaVersion": 1,
  "id": "flux2-klein-text-to-image",
  "label": "Flux 2 Klein Text to Image",
  "provider": "comfyui",
  "classification": "image.generate",
  "description": "Prompt-based image generation using the bundled Flux 2 Klein workflow.",
  "workflowFile": "flux2-klein-text-to-image.workflow.json",
  "contract": {
    "inputs": {
      "prompt": {
        "type": "string",
        "required": true,
        "authoring": {
          "editorField": "textarea"
        }
      },
      "width": {
        "type": "integer",
        "required": false,
        "defaultValue": 1024,
        "authoring": {
          "editorField": "integer"
        }
      },
      "height": {
        "type": "integer",
        "required": false,
        "defaultValue": 1024,
        "authoring": {
          "editorField": "integer"
        }
      },
      "steps": {
        "type": "integer",
        "required": false,
        "defaultValue": 20,
        "authoring": {
          "editorField": "integer"
        }
      },
      "seed": {
        "type": "integer",
        "required": false,
        "authoring": {
          "editorField": "integer"
        }
      },
      "filenamePrefix": {
        "type": "string",
        "required": false,
        "defaultValue": "NovelTea",
        "authoring": {
          "editorField": "text"
        }
      }
    },
    "outputs": {
      "images": {
        "mediaType": "image",
        "required": true,
        "cardinality": "many"
      }
    }
  },
  "bindings": {
    "prompt": [
      {
        "nodeId": "76",
        "nodeTitle": "noveltea.prompt",
        "classType": "PrimitiveStringMultiline",
        "inputName": "value",
        "selector": {
          "title": "noveltea.prompt",
          "classType": "PrimitiveStringMultiline",
          "inputName": "value"
        }
      }
    ],
    "width": [
      {
        "nodeId": "75:68",
        "nodeTitle": "noveltea.width",
        "classType": "PrimitiveInt",
        "inputName": "value",
        "selector": {
          "title": "noveltea.width",
          "classType": "PrimitiveInt",
          "inputName": "value"
        }
      }
    ],
    "height": [
      {
        "nodeId": "75:69",
        "nodeTitle": "noveltea.height",
        "classType": "PrimitiveInt",
        "inputName": "value",
        "selector": {
          "title": "noveltea.height",
          "classType": "PrimitiveInt",
          "inputName": "value"
        }
      }
    ],
    "seed": [
      {
        "nodeId": "75:73",
        "nodeTitle": "noveltea.seed",
        "classType": "RandomNoise",
        "inputName": "noise_seed",
        "selector": {
          "title": "noveltea.seed",
          "classType": "RandomNoise",
          "inputName": "noise_seed"
        }
      }
    ],
    "steps": [
      {
        "nodeId": "75:62",
        "nodeTitle": "noveltea.steps",
        "classType": "Flux2Scheduler",
        "inputName": "steps",
        "selector": {
          "title": "noveltea.steps",
          "classType": "Flux2Scheduler",
          "inputName": "steps"
        }
      }
    ],
    "filenamePrefix": [
      {
        "nodeId": "9",
        "nodeTitle": "noveltea.output",
        "classType": "SaveImage",
        "inputName": "filename_prefix",
        "selector": {
          "title": "noveltea.output",
          "classType": "SaveImage",
          "inputName": "filename_prefix"
        }
      }
    ]
  },
  "requiredNodeClasses": [
    "SaveImage",
    "PrimitiveStringMultiline",
    "KSamplerSelect",
    "Flux2Scheduler",
    "CFGGuider",
    "SamplerCustomAdvanced",
    "VAEDecode",
    "EmptyFlux2LatentImage",
    "CLIPTextEncode",
    "PrimitiveInt",
    "RandomNoise",
    "UNETLoader",
    "CLIPLoader",
    "VAELoader"
  ],
  "outputBindings": {
    "images": [
      {
        "nodeId": "9",
        "nodeTitle": "noveltea.output",
        "classType": "SaveImage"
      }
    ]
  }
}
