---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="NovelTea">
  <section class="nt-hero">
    <div>
      <p class="nt-kicker">Narrative engine + editor</p>
      <h1>Build worlds that respond.</h1>
      <p>
        NovelTea is an in-development toolkit for authored narrative experiences, combining a portable runtime,
        visual editing, Lua scripting, and Web export in one project model.
      </p>
      <div class="nt-actions">
        <a class="nt-button nt-button--primary" href="/docs/dev/">Read development docs</a>
        <a class="nt-button" href="/examples/dev/">Explore examples</a>
      </div>
    </div>
  </section>
</SiteLayout>
