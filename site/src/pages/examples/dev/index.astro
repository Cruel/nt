---
import SiteLayout from '../../../layouts/SiteLayout.astro';
---

<SiteLayout title="Development examples" description="Development examples built against current NovelTea tooling.">
  <section class="nt-page-heading">
    <p class="nt-status">Development channel</p>
    <h1>Examples are coming online.</h1>
    <p>
      This is the development showcase shell for examples built against current NovelTea tooling. The first playable
      Materials and Verbs projects will land here with their matching Web player and editable project downloads.
    </p>
  </section>
  <section class="nt-grid" aria-label="Planned development examples">
    <article class="nt-card">
      <h2>Materials</h2>
      <p>A compact visual demonstration of NovelTea material and rendering behavior.</p>
    </article>
    <article class="nt-card">
      <h2>Verbs</h2>
      <p>A focused interaction example showing authored actions and command-building behavior.</p>
    </article>
  </section>
</SiteLayout>
