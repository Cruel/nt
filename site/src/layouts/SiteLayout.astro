---
import NovelTeaBrand from '../components/NovelTeaBrand.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'NovelTea is an in-development engine and editor for expressive narrative games.',
} = Astro.props;
const pageTitle = title === 'NovelTea' ? title : `${title} · NovelTea`;
const pathname = Astro.url.pathname;
const navItems = [
  { label: 'Docs', href: '/docs/' },
  { label: 'Examples', href: '/examples/dev/' },
  { label: 'Download', href: '/download/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#081216" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="nt-skip-link" href="#main-content">Skip to content</a>
    <header class="nt-site-header">
      <div class="nt-shell nt-site-header__inner">
        <NovelTeaBrand />
        <nav class="nt-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content" class="nt-shell">
      <slot />
    </main>
    <footer class="nt-shell nt-footer">
      <span>NovelTea is under active development. Public interfaces may change before the first release.</span>
      <a href="/docs/dev/">Development docs</a>
    </footer>
  </body>
</html>
